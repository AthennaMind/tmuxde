# Next's generated ambient types. They import from whichever dist directory
# ran last (`.next-dev` or `.next-build`), so committing them breaks other
# machines. Next regenerates the file on every `dev`/`build`, and
# `tsc --noEmit` passes without it.
apps/web/next-env.d.ts

# Host binaries copied for local Docker access to existing tmux sessions.
.docker/host-tmux/
.docker/certs/

# Local agent settings.
.claude/local/
.claude/settings.local.json
CLAUDE.local.md
