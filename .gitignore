# Dependencies
node_modules/

# Local checkouts of other projects, for reference
.external/

# Build outputs
dist/
out/

# Tool caches
.cache/

# Vite dependency cache of the React app in src/ui. Its build output
# src/ui/dist is covered by dist/ above. No leading path, so the pattern
# also matches in the dev containers, where src/ui is /workspace and Tailwind
# reads this file to skip the cache.
.vite/

# Environment variables
.env
.env.*
!.env.example

# Database
*.db
*.db-journal

# Testing
coverage/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Debug
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local logs
logs/

# Misc
*.tsbuildinfo
*.pem

# playwright-cli session artifacts
.playwright-cli/

# npm pack output
*.tgz

# Local runtime state.
data/

# Local worktrees (see .worktrees/<branch>). These are checkouts, not source.
.worktrees/

# Python bytecode from setup.py and the Docker tests.
__pycache__/

# Public copy of the Caddy local CA root, for device trust.
.docker/certs/

# Go binaries built by the gotools service. The dir itself stays tracked so
# Docker does not create it as root.
.docker/bin/*
!.docker/bin/.gitkeep

# Web build embedded by the Go server. .gitkeep keeps the embed compiling
# without a build. dist/ above ignores the dir, so it is re-included first.
!/web/dist/
/web/dist/*
!/web/dist/.gitkeep

# Local agent settings.
.claude/local/
.claude/settings.local.json
AGENTS.local.md
CLAUDE.local.md
