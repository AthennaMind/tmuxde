# Dependencies
node_modules/
.pnpm-store/

# Local development state and credentials.
.local/

# Local checkouts of other projects, for reference
.external/

# Build outputs
dist/
out/

# Tool caches
.cache/
cmd/tmuxde-stt/internal/bundle/models/

# Vite caches in ui/node_modules/.vite and Vitest in ui/.cache/vite, both
# ignored above. Build output ui/dist is covered by dist/. .vite/ stays as
# a guard for a custom cacheDir.
.vite/

# Environment variables
.env
.env.*
!.env.example

# Database
*.db
*.db-journal

# Testing
coverage/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Debug
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local logs
logs/

# Misc
*.tsbuildinfo
*.pem

# playwright-cli session artifacts
.playwright-cli/

# npm pack output
*.tgz

# Local runtime state.
data/

# Local worktrees (see .worktrees/<branch>). These are checkouts, not source.
.worktrees/

# Python bytecode from setup and runtime checks.
__pycache__/

# Web build embedded by the Go server. .gitkeep keeps the embed compiling
# without a build. dist/ above ignores the dir, so it is re-included first.
!/web/dist/
/web/dist/*
!/web/dist/.gitkeep

# Local agent settings.
.claude/local/
.claude/settings.local.json
AGENTS.local.md
CLAUDE.local.md

# Agent plans, backlogs and reviews. Local working notes, never committed.
# Skills under .agents/skills stay tracked.
.agents/plans/
.agents/reviews/
