{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        ".next-build/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  },
  "globalEnv": [
    "NEXT_DIST_DIR",
    "NODE_ENV",
    "NEXT_PUBLIC_RELAY_URL",
    "RELAY_PORT",
    "RELAY_HOST",
    "AUTH_TOKEN",
    "ALLOWED_PATHS",
    "TMUX_SOCKET",
    "CORS_ORIGINS",
    "NEXT_TELEMETRY_DISABLED",
    "TURBO_TELEMETRY_DISABLED",
    "DO_NOT_TRACK"
  ]
}
