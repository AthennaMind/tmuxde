FROM node:22-alpine AS base
LABEL org.opencontainers.image.source="https://github.com/mtmux/mtmux"
LABEL org.opencontainers.image.description="mtmux web client — your tmux sessions in any browser"
LABEL org.opencontainers.image.licenses="MIT"

RUN apk add --no-cache wget
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app

# Prune stage
FROM base AS pruner
COPY . .
RUN pnpm dlx turbo@2.3.3 prune @app/web --docker

# Install stage
FROM base AS installer
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile

# Build stage.
#
# The broker origin has to arrive here, not at runtime: Next inlines
# NEXT_PUBLIC_* into the client bundle when it builds. An image built without
# it serves a pair page that renders "not configured", and no environment
# variable on the running container can fix it.
FROM installer AS builder
ARG NEXT_PUBLIC_API_URL=""
ARG NEXT_PUBLIC_RELAY_URL=""
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_RELAY_URL=$NEXT_PUBLIC_RELAY_URL
COPY --from=pruner /app/out/full/ .
RUN pnpm turbo build --filter=@app/web

# Runner stage
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache wget
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public
USER nextjs
EXPOSE 24100
ENV PORT=24100

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s \
  CMD wget --spider -q http://localhost:24100/ || exit 1

CMD ["node", "apps/web/server.js"]
