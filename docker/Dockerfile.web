FROM node:22-alpine AS base
LABEL org.opencontainers.image.source="https://github.com/mtmux/mtmux"
LABEL org.opencontainers.image.description="mtmux web client — your tmux sessions in any browser"
LABEL org.opencontainers.image.licenses="MIT"

RUN apk add --no-cache wget
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app

# Prune stage
FROM base AS pruner
COPY . .
RUN pnpm dlx turbo@2.3.3 prune @app/web --docker

# Install stage
FROM base AS installer
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile

# Build stage.
#
# The broker origin has to arrive here, not at runtime: Next inlines
# NEXT_PUBLIC_* into the client bundle when it builds. An image built without
# it serves a pair page that renders "not configured", and no environment
# variable on the running container can fix it.
FROM installer AS builder
# Build into `.next`, which is the one place nothing else writes.
#
# `apps/web/next.config.ts` defaults production builds to `.next-build`, a
# staging directory that `scripts/promote-build.mjs` later moves into
# `.next-serve` — the split that exists because `next build` clears its own
# dist directory and so cannot be pointed at a tree a live server is reading.
# None of that applies in an image: the build and the runner are separate
# stages, nothing is serving, and there is nothing to promote. But the runner
# below copies from `.next/standalone`, and when the default moved the copy
# was never updated, so every image build since has failed on a path that no
# longer exists. `NEXT_DIST_DIR` is the config's own documented override.
ENV NEXT_DIST_DIR=.next
ARG NEXT_PUBLIC_API_URL=""
ARG NEXT_PUBLIC_RELAY_URL=""
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_RELAY_URL=$NEXT_PUBLIC_RELAY_URL
COPY --from=pruner /app/out/full/ .
RUN pnpm turbo build --filter=@app/web

# Runner stage
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache wget
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public
USER nextjs
EXPOSE 24100
ENV PORT=24100

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s \
  CMD wget --spider -q http://localhost:24100/ || exit 1

CMD ["node", "apps/web/server.js"]
