[
  { "key": "ctrl+shift+b", "command": "sidebar.toggle" },
  { "key": "ctrl+b", "command": "-sidebar.toggle" },
  {
    "mac": "cmd+j",
    "command": "palette.open",
    "args": { "mode": "terminals" },
    "scope": "app"
  },
  { "key": "mod+k", "mac": "cmd+k", "command": "palette.commands", "scope": "global" },
  { "key": "alt+meta+super+win+f12", "command": "tmux.nextWindow", "scope": "terminal" },
  { "key": "ctrl+shift+alt+cmd+meta+super+win+mod+pagedown", "command": "tmux.nextPane" },
  { "key": "shift+/", "command": "shortcuts.open", "scope": "app" },
  { "key": "ctrl+shift+space", "command": "dictation.toggle" },
  { "key": "ctrl+=", "command": "terminal.zoomIn" },
  { "key": "ctrl+shift+=", "command": "terminal.zoomIn" },
  { "key": "ctrl+-", "command": "terminal.zoomOut" },
  { "key": "ctrl+0", "command": "terminal.zoomReset" },
  { "key": "ctrl+shift+l", "mac": "cmd+shift+l", "command": "lock.now" },
  { "key": "escape", "command": "views.close", "args": null },
  { "key": "ctrl+\\", "command": "terminal.prefix", "args": [1, "two", true] },
  { "key": "alt+`", "command": "tmux.previousWindow", "args": "text" },
  { "key": "alt+[", "command": "tmux.previousPane", "args": 3 },
  { "key": "alt+]", "command": "tmux.nextPane", "args": false },
  { "key": "alt+,", "command": "my.custom2.command" },
  { "key": "alt+.", "command": "my.customCommand" },
  { "key": "alt+;", "command": "tmux.splitRight" },
  { "key": "alt+'", "command": "tmux.splitDown" },
  { "key": "enter", "command": "tmux.zoomPane", "scope": "app" },
  { "key": "tab", "command": "palette.files", "scope": "app" },
  { "key": "backspace", "command": "views.closeAll", "scope": "app" },
  { "key": "delete", "command": "tmux.killPane", "scope": "app" },
  { "key": "up", "command": "tmux.previousPane", "scope": "app" },
  { "key": "down", "command": "tmux.nextPane", "scope": "app" },
  { "key": "left", "command": "tmux.previousWindow", "scope": "app" },
  { "key": "right", "command": "tmux.nextWindow", "scope": "app" },
  { "key": "home", "command": "overview.toggle", "scope": "app" },
  { "key": "end", "command": "sidebar.files", "scope": "app" },
  { "key": "pageup", "command": "terminal.copyMode", "scope": "terminal" },
  { "key": "f1", "command": "shortcuts.open" },
  { "key": "z", "command": "terminal.suspend", "scope": "terminal" },
  { "key": "shift+9", "command": "theme.system" }
]
