# make setup creates dev .env with random token and host UID/GID.
AUTH_TOKEN='replace-with-random-token'
# Your userid groupid, used to mount the code into
# the containers with your ids so the permissions stay
# the same
DEV_UID='1000'
DEV_GID='1000'

# Optional hostname for an existing local HTTPS proxy.
LOCAL_DOMAIN='localhost'
