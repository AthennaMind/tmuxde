# Root .env is written by scripts/setup.sh. Do not copy this file by hand.
# Rerun setup instead. It keeps LOCAL_DOMAIN, LOCAL_BIND_IP and the run
# directory across reruns. The token itself lives in .docker/.env.token.
AUTH_TOKEN='64 hex characters, same as .docker/.env.token'
LOCAL_UID='1000'
LOCAL_GID='1000'
DEV_UID='1000'
DEV_GID='1000'
LOCAL_UPLOAD_DIR='/home/you/.local/share/tmuxde/uploads'
LOCAL_HOST_HOME='/home/you'
LOCAL_DOMAIN='localhost'
LOCAL_BIND_IP='127.0.0.1'
# Run directory: http.sock, dev/http-dev.sock and stt/stt.sock.
LOCAL_STT_SOCKET_DIR='/home/you/.local/state/tmuxde/run'
# Only with scripts/setup.sh --dictation.
COMPOSE_PROFILES='dictation'
LOCAL_STT_MODELS='/home/you/.local/share/tmuxde/models'
STT_THREADS='4'
