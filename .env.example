# Local development only. Docker setup writes docker/local/.env separately.
# Export settings into your shell before pnpm dev.
AUTH_TOKEN="change-me-in-production"
RELAY_HOST="127.0.0.1"
RELAY_PORT="14300"
CORS_ORIGINS="http://localhost:14100"
ALLOWED_PATHS="/home"
TMUX_SOCKET=""
NEXT_PUBLIC_RELAY_URL="ws://localhost:14300"
NEXT_TELEMETRY_DISABLED="1"
TURBO_TELEMETRY_DISABLED="1"
DO_NOT_TRACK="1"
