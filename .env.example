# ccremote — Example configuration
#
# Copy this file to `.env` and edit values for your environment.
# In production, `NODE_ENV=production` is expected. The relay server will
# refuse to boot if AUTH_TOKEN is empty or left as the default sentinel.
#
# Generate a strong token:
#   openssl rand -hex 32
#
# ─────────────────────────────────────────────────────────────────────────
# Production quickstart
# ─────────────────────────────────────────────────────────────────────────
#   1. cp .env.example .env
#      Set AUTH_TOKEN, CORS_ORIGINS, NEXT_PUBLIC_RELAY_URL.
#   2. pnpm install
#   3. pnpm start:prod        # builds + starts under PM2 on prod ports
#                             # (web 24100, docs 24102, relay 24300)
#   4. pnpm logs:prod
# ─────────────────────────────────────────────────────────────────────────


# === Relay Server =========================================================

# REQUIRED in production. Shared secret between the relay server and clients.
# DO NOT ship the default value to production — the relay will exit on boot.
AUTH_TOKEN="change-me-in-production"

# Bind address and port for the relay WebSocket server.
# Dev default is 14300; production (pnpm start:prod / docker prod) uses 24300.
RELAY_PORT=14300
RELAY_HOST="0.0.0.0"

# Comma-separated list of host paths the file browser is allowed to read.
# Keep this as narrow as possible (e.g. "/home/deploy/projects").
ALLOWED_PATHS="/home"

# Optional: explicit tmux socket path. Leave empty to use tmux's default.
# On Linux the default is typically /tmp/tmux-$(id -u)/default.
TMUX_SOCKET=""

# Shell used for newly created tmux sessions.
TMUX_DEFAULT_SHELL="/bin/bash"

# Max WS messages per rate-limit window per connection.
WS_RATE_LIMIT=100

# Idle-disconnect timeout (minutes).
IDLE_TIMEOUT_MINUTES=30

# REQUIRED in production. Comma-separated list of allowed web origins.
# Must include the exact public origin of the web app, e.g.
#   CORS_ORIGINS="https://ccremote.example.com"
CORS_ORIGINS="http://localhost:14100"


# === Web App =============================================================

# REQUIRED for the SPLIT deployment (Docker/PM2), where the relay listens on
# its own port. Public WebSocket URL the browser uses to reach the relay.
# In production use `wss://` (TLS) — the browser will refuse `ws://` from
# an `https://` page. Production default port is 24300 (dev: 14300).
#
# Leave it UNSET for single-port mode (`tmuxremote start`, `pnpm dev`): the
# browser then uses the page's own origin plus `/_relay`. Setting it here
# overrides that, which is why `pnpm dev:split` passes it explicitly rather
# than relying on this file.
NEXT_PUBLIC_RELAY_URL="ws://localhost:14300"

# Optional override of the web app port (must match your reverse proxy).
# Dev default 14100; production default 24100.
WEB_PORT=14100


# === Docs Site ===========================================================

# Optional override of the docs app port.
# Dev default 14102; production default 24102.
DOCS_PORT=14102


# === Pairing Broker (apps/api) ===========================================
#
# Only needed if you HOST the broker yourself. Nothing in `mtmux start` or the
# self-hosted split deployment talks to it unless the user runs `mtmux pair`.

# Bind address and port for the broker. Dev 14400; production 24400.
API_PORT=14400
API_HOST="127.0.0.1"

# Public origin of the broker, used by the CLI and the hosted web app.
NEXT_PUBLIC_API_URL="http://localhost:14400"

# Comma-separated origins allowed to call the broker's HTTP endpoints.
API_CORS_ORIGINS="http://localhost:14100"

# Abuse controls. The first two are per-IP sliding windows; the two claim
# ceilings deliberately ignore the caller's address, because a pairing code's
# safety margin cannot depend on how many addresses an attacker has. Tunnel
# quotas are per tunnel.
API_CLAIMS_PER_MINUTE=5
API_SLOT_CLAIMS_PER_MINUTE=4
API_GLOBAL_CLAIMS_PER_MINUTE=200
API_MAILBOXES_PER_MINUTE=10
API_TUNNEL_MAX_BYTES=1073741824
API_TUNNEL_MAX_MINUTES=720

# The pairing protocol floor. Empty means "the version this build ships with",
# which is what the hosted broker runs. Set 0 to accept every client, including
# ones that declare no version at all — a self-hosted broker answers to nobody
# else's release schedule. API_ADVISORY is reported by GET /v1/version, so you
# can say something urgent to every running CLI without shipping code.
API_MIN_PROTOCOL=
API_ADVISORY=

# === Accounts and billing (apps/api, hosted only) ========================
#
# EVERYTHING IN THIS SECTION IS OPTIONAL. With DATABASE_URL unset, accounts
# and billing are switched off entirely: `/api/auth/*` and `/v1/{me,servers,
# billing}/*` answer 503, and pairing, the sealed tunnel and terminal access
# work exactly as they do today. Self-hosters should leave this whole block
# alone — it exists for the hosted service at api.mtmux.com.

# SQLite file for accounts. Migrations run at boot; the directory is created
# if it does not exist. Setting this is what turns accounts on.
DATABASE_URL=""

# REQUIRED once DATABASE_URL is set. Signs session cookies and bearer tokens.
# The broker refuses to boot in production with the development default.
#   openssl rand -hex 32
BETTER_AUTH_SECRET=""

# Public origin of THIS api, and the issuer better-auth signs against.
# Defaults to http://<API_HOST>:<API_PORT>. Must be https:// in production.
BETTER_AUTH_URL=""

# Public origin of the browser app. Used for the device-approval page
# (<APP_ORIGIN>/device), the upgrade link and checkout return URLs.
APP_ORIGIN="http://localhost:14100"

# Cookie domain, so app.<domain> and api.<domain> share one session, e.g.
# ".mtmux.com". LEAVE EMPTY FOR LOCAL DEVELOPMENT — a cookie scoped to a real
# domain is never sent to 127.0.0.1, and sign-in fails with a 401 that points
# nowhere near the cause.
AUTH_COOKIE_DOMAIN=""

# better-auth's own CSRF allow-list, comma-separated. Separate from CORS
# (API_CORS_ORIGINS) and both must list an origin. Defaults to APP_ORIGIN plus
# API_CORS_ORIGINS, which is right for almost everyone.
AUTH_TRUSTED_ORIGINS=""

# How recently a server must have sent a heartbeat to show as online.
SERVER_ONLINE_WINDOW_SECONDS=90

# `mtmux login` device grant: advertised (and enforced) poll interval, and how
# long someone has to type the code into a browser.
DEVICE_POLL_SECONDS=5
DEVICE_CODE_MINUTES=15

# Per-account sliding windows for the account API.
ACCOUNT_REQUESTS_PER_MINUTE=120
ACCOUNT_WRITES_PER_MINUTE=30

# Per-IP window for POST /v1/auth/lookup, the route that tells the sign-in page
# which methods an address has. It is an account-enumeration oracle by design,
# so it gets its own bucket an order of magnitude tighter than writes: at 30/min
# one IP could probe 43,000 addresses a day.
ACCOUNT_LOOKUPS_PER_MINUTE=10

# --- Passkeys ------------------------------------------------------------
#
# ⚠︎ PASSKEY_RP_ID IS A ONE-WAY DOOR. Every passkey a browser stores is bound
# to the rpID it was created under; changing it later silently invalidates all
# of them, with no recovery beyond enrolling again.
#
# Leave it EMPTY unless you serve the app and the API on different hostnames.
# Empty means "the hostname of APP_ORIGIN", which is correct for local
# development and for every self-hoster serving a single origin.
#
# The hosted deployment sets "mtmux.com" (in ecosystem.config.cjs), because the
# app is app.mtmux.com while this API is api.mtmux.com — and the value must be
# a registrable-domain suffix of the origin the browser runs the ceremony on,
# or every registration fails with SecurityError.
PASSKEY_RP_ID=""
PASSKEY_RP_NAME="mtmux"

# --- Transactional email (Resend) ----------------------------------------
#
# Leave RESEND_API_KEY empty and mail is off entirely: no verification, no
# password reset, and the magic-link plugin is never mounted, so the sign-in
# page never offers a button that would do nothing. Nothing else changes.
#
# Sending from your own domain also needs SPF and DKIM records. If an SPF TXT
# record already exists it must be MERGED — two SPF records is a permerror, not
# a fallback.
RESEND_API_KEY=""

# Required alongside the key. RFC 5322 form, e.g. "mtmux <hello@mtmux.com>".
EMAIL_FROM=""
EMAIL_REPLY_TO=""

# --- Social sign-in ------------------------------------------------------
#
# A provider appears only when BOTH halves are set, so a half-configured one is
# off rather than broken at the callback.
#
# Redirect URIs live under BETTER_AUTH_URL, not APP_ORIGIN:
#   https://api.mtmux.com/api/auth/callback/google
#   https://api.mtmux.com/api/auth/callback/github
# Google additionally needs APP_ORIGIN as an authorized JavaScript origin.
# GitHub allows exactly one callback per OAuth App, so production and
# development need two separate apps.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Dodo Payments -------------------------------------------------------
#
# Leave DODO_PAYMENTS_API_KEY empty and billing is off: /v1/billing reports
# billingEnabled:false and checkout answers 503, while accounts still work.

DODO_PAYMENTS_API_KEY=""

# ⚠︎ The Dodo SDK's own default is live_mode. This defaults to test_mode so a
# missing value bills nobody. Set it to live_mode deliberately, or not at all.
DODO_ENVIRONMENT="test_mode"

# Signing key from the Dodo dashboard's webhook settings ("whsec_...").
# The endpoint to register there is <BETTER_AUTH_URL>/api/auth/dodopayments/webhooks
DODO_WEBHOOK_KEY=""

# Product ids for the paid plan. Yearly is optional; without it only the
# monthly checkout is offered.
DODO_PRODUCT_PRO_MONTHLY=""
DODO_PRODUCT_PRO_YEARLY=""

# Create a Dodo customer during sign-up. Off deliberately: the plugin's hook
# throws a 500 when Dodo is unreachable, which would make an outage at the
# payment provider an outage in account registration. The first checkout
# creates the customer anyway.
DODO_CREATE_CUSTOMER_ON_SIGNUP=false


# === Reverse DNS and per-device TLS (apps/api, Phase 3) ==================
#
# Leave empty to disable. Without these the broker still pairs and tunnels;
# it just cannot hand out <slug>.lan.<zone> names or certificates, so every
# remote session goes over the tunnel instead of racing a direct candidate.

# Cloudflare API token with DNS:Edit on the zone below.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""

# Zone the broker manages, e.g. "mtmux.com". Records are created under
# <slug>.lan.<zone> (RFC1918 address) and <slug>.d.<zone> (public address).
DNS_ZONE=""

# ACME account email and directory for per-device certificates.
# Certificate issuance stays OFF unless ACME_ENABLED=true: Let's Encrypt caps
# certificates at 50 per registered domain per week, which is a hard ceiling
# at any real scale. Get a rate-limit exemption or a CA with EAB first.
ACME_ENABLED=false
ACME_DIRECTORY="https://acme-v02.api.letsencrypt.org/directory"


# === Reverse Proxy (optional) ============================================
#
# These are only consumed by the bundled `nginx/` configs. They are safe to
# leave unset if you terminate TLS elsewhere (e.g. Caddy, Cloudflare, a
# managed load balancer).

# Public domain name the app is served from, e.g. "ccremote.example.com".
PUBLIC_DOMAIN=""

# Email used by certbot / Let's Encrypt for expiry notices.
ACME_EMAIL=""
