{
  "name": "mtmux",
  "version": "0.12.1",
  "description": "tmux in your browser. One command, any device.",
  "keywords": [
    "mtmux",
    "claude",
    "claude-code",
    "tmux",
    "terminal",
    "browser",
    "remote",
    "self-hosted",
    "websocket"
  ],
  "homepage": "https://github.com/mtmux/mtmux#readme",
  "bugs": "https://github.com/mtmux/mtmux/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/mtmux/mtmux.git",
    "directory": "apps/cli"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "mtmux": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/dev.mjs",
    "watch": "tsc --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "start": "node dist/bin.js start",
    "token": "node dist/bin.js token",
    "help": "node dist/bin.js --help",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run && pnpm build && pnpm smoke",
    "pack:dryrun": "npm pack --dry-run",
    "prepublishOnly": "MTMUX_BUILD_API_URL= pnpm build",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "chokidar": "^4",
    "commander": "^12.1.0",
    "kleur": "^4.1.5",
    "next": "^16.2.12",
    "node-pty": "^1.1.0",
    "open": "^10.1.0",
    "pino": "^9",
    "pino-pretty": "^13",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.18.0",
    "zod": "^3"
  },
  "devDependencies": {
    "@repo/crypto": "workspace:*",
    "@repo/protocol": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.27.0",
    "tsx": "^4",
    "typescript": "^5.6.0",
    "vitest": "^2"
  },
  "publishConfig": {
    "access": "public"
  }
}
