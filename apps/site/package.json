{
  "name": "@app/site",
  "license": "MIT",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Marketing site, docs and blog for mtmux — the tmux sessions you already run, in any browser.",
  "scripts": {
    "dev": "next dev --port 14101",
    "build": "next build",
    "start": "next start --port ${PORT:-41317} --hostname ${HOSTNAME:-127.0.0.1}",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run lint",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "next-intl": "^4.13.4",
    "next-mdx-remote-client": "^2.1.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.15.0",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2",
    "@types/react-dom": "^19.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4",
    "tw-animate-css": "^1",
    "typescript": "^5.8",
    "vitest": "^2"
  },
  "engines": {
    "node": ">=22"
  }
}
