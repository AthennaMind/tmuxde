{
  "extends": "@repo/tsconfig/nextjs.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "allowJs": true,
    "tsBuildInfoFile": ".turbo/tsconfig.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-build/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-lab/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
